# Copy to .env for local development. Do not commit real secrets.

ASSETMIND_ENV=development
ASSETMIND_DATABASE_URL=sqlite+pysqlite:///./assetmind.db
ASSETMIND_API_KEY=
ASSETMIND_CORS_ORIGINS=http://localhost:3000
ASSETMIND_PROVIDER_MODE=fixtures
ASSETMIND_AGENTOS_ENABLED=false
ASSETMIND_AGENTOS_JWT_SECRET=

# Optional live providers and narrative model.
BRAPI_API_KEY=
COINGECKO_API_KEY=
OPENROUTER_API_KEY=
ASSETMIND_OPENROUTER_MODEL=

# Guardrails for one basic analysis. Scaled by asset count where noted in the README.
ASSETMIND_MAX_TOTAL_TOKENS=4000
ASSETMIND_MAX_OUTPUT_TOKENS=1200
ASSETMIND_MAX_LLM_CALLS=8
ASSETMIND_MAX_PROVIDER_CALLS=12
ASSETMIND_MAX_ESTIMATED_COST_USD=0.03
ASSETMIND_DEADLINE_SECONDS=25
ASSETMIND_RATE_LIMIT_PER_MINUTE=30
