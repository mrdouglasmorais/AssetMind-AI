# Copy to .env for local development. Do not commit real secrets.

ASSETMIND_ENV=development
ASSETMIND_DATABASE_URL=sqlite+pysqlite:///./assetmind.db
ASSETMIND_API_KEY=
ASSETMIND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ASSETMIND_PROVIDER_MODE=fixtures
ASSETMIND_AGENTOS_ENABLED=true
ASSETMIND_AGENTOS_JWT_SECRET=
# Signed with the JWT secret above. make watch sends it to the Agent UI.
ASSETMIND_AGENT_UI_TOKEN=
ASSETMIND_OS_SECURITY_KEY=
ASSETMIND_AGENT_UI_URL=http://127.0.0.1:3000

# Groq is the LLM provider. Paste a key from https://console.groq.com/keys
ASSETMIND_LLM_PROVIDER=groq
GROQ_API_KEY=
ASSETMIND_GROQ_MODEL=openai/gpt-oss-120b
# Session retrieval. hashed keeps tests offline. groq calls nomic-embed-text-v1.5.
ASSETMIND_EMBEDDING_PROVIDER=hashed
ASSETMIND_EMBEDDING_MODEL=nomic-embed-text-v1.5

# Optional live market-data keys. Fixtures are used while these stay empty.
BRAPI_API_KEY=
COINGECKO_API_KEY=

# Kept for the alternate gateway. Unused while ASSETMIND_LLM_PROVIDER=groq.
OPENROUTER_API_KEY=
ASSETMIND_OPENROUTER_MODEL=

# Guardrails for one basic analysis. Scaled by asset count where noted in the README.
ASSETMIND_TOKEN_ALLOWANCE=100000
ASSETMIND_MAX_TOTAL_TOKENS=4000
ASSETMIND_MAX_OUTPUT_TOKENS=1200
ASSETMIND_MAX_LLM_CALLS=8
ASSETMIND_MAX_PROVIDER_CALLS=12
ASSETMIND_MAX_ESTIMATED_COST_USD=0.03
ASSETMIND_DEADLINE_SECONDS=25
ASSETMIND_RATE_LIMIT_PER_MINUTE=30
