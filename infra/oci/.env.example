# Copy to infra/oci/.env (gitignored). Never commit real secrets.

# --- Postgres ---
POSTGRES_USER=assetmind
POSTGRES_PASSWORD=replace-with-long-random
POSTGRES_DB=assetmind

# --- Ingress ---
# Use :80 for IP smoke tests. Use a DNS name for automatic HTTPS via Caddy.
ASSETMIND_SITE_ADDRESS=:80
ACME_EMAIL=

# --- Application ---
ASSETMIND_API_KEY=replace-with-long-random
ASSETMIND_PROVIDER_MODE=live
ASSETMIND_LLM_PROVIDER=groq
ASSETMIND_GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
BRAPI_API_KEY=
COINGECKO_API_KEY=
OPENROUTER_API_KEY=
ASSETMIND_OPENROUTER_MODEL=

# Durable worker queue (ADR 0024). Keep true on OCI production.
ASSETMIND_JOB_QUEUE_ENABLED=true
ASSETMIND_WORKER_CONCURRENCY=1
ASSETMIND_WORKER_POLL_SECONDS=5
ASSETMIND_WORKER_LEASE_SECONDS=60
ASSETMIND_JOB_MAX_ATTEMPTS=3
ASSETMIND_WORKER_ID=worker-1

# Optional prebuilt multi-arch image (skip local build)
# ASSETMIND_IMAGE=ghcr.io/mrdouglasmorais/assetmind-ai:sha-immutable
