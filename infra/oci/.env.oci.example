# Production secrets for /opt/assetmind/.env on the OCI host.
# Do not commit a filled copy. Generate strong values before the first compose up.

POSTGRES_USER=assetmind
POSTGRES_PASSWORD=replace-with-long-random
POSTGRES_DB=assetmind

ASSETMIND_API_KEY=replace-with-long-random
ASSETMIND_PROVIDER_MODE=live
ASSETMIND_LLM_PROVIDER=groq
ASSETMIND_GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENROUTER_API_KEY=
ASSETMIND_OPENROUTER_MODEL=
BRAPI_API_KEY=
COINGECKO_API_KEY=

# Optional: pull a prebuilt multi-arch image instead of building on the host.
# ASSETMIND_IMAGE=ghcr.io/YOUR_ORG/assetmind-ai:latest
