# Copy to terraform.tfvars (gitignored) and fill with values from the OCI Console.
# API keys: Identity → Users → your user → API Keys.

tenancy_ocid        = "ocid1.tenancy.oc1..example"
user_ocid           = "ocid1.user.oc1..example"
fingerprint         = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path    = "~/.oci/oci_api_key.pem"
region              = "sa-saopaulo-1"
compartment_ocid    = "ocid1.tenancy.oc1..example"

ssh_public_key      = "ssh-ed25519 AAAA... assetmind-oci"
ssh_allowed_cidr    = "203.0.113.10/32"

# Optional overrides.
# Pipeline prefers VM.Standard.E2.1.Micro (x86 Always Free), then A1.Flex.
# shape                  = "VM.Standard.E2.1.Micro"
# shape                  = "VM.Standard.A1.Flex"
# instance_ocpus         = 1   # Flex shapes only
# instance_memory_in_gbs = 6   # Flex shapes only
# boot_volume_size_in_gbs = 47
# availability_domain_number = 1
# When GitHub Actions owns the VM:
# enable_compute = false
