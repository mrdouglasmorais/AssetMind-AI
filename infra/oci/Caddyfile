# Reverse proxy for AssetMind on OCI Always Free.
# ASSETMIND_SITE_ADDRESS examples:
#   :80                 local / IP smoke test (HTTP only)
#   analysis.example.com  production (Caddy obtains HTTPS via ACME)
#
# API is internal-only (Docker network). Postgres and worker are never published.

{
	email {$ACME_EMAIL:}
}

{$ASSETMIND_SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle /ready {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy api:8000 {
			# Flush immediately so SSE / event-stream is not buffered.
			flush_interval -1
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}
}
